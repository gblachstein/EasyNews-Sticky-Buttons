{
  "manifest_version": 3,
  "name": "Easy NZB Button",
  "version": "1.0.0",
  "description": "Adds a persistent NZB button in the bottom-right that mirrors the site's NZB action.",
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "content_scripts": [
    {
      "matches": [
        "https://members.easynews.com/*"
      ],
      "js": [
        "content.js"
      ],
      "css": [
        "content.css"
      ],
      "run_at": "document_idle"
    }
  ],
  "host_permissions": [
    "https://members.easynews.com/*"
  ],
  "permissions": []
}
