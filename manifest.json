{
  "manifest_version": 3,
  "name": "Easy NZB Button",
  "version": "1.1.0",
  "description": "Adds persistent NZB, ZIP, and Uncheck All buttons in the bottom-right that mirror the site's own actions.",
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "options_page": "options.html",
  "content_scripts": [
    {
      "matches": [
        "https://members.easynews.com/*"
      ],
      "js": [
        "content.js"
      ],
      "css": [
        "content.css"
      ],
      "run_at": "document_idle"
    }
  ],
  "host_permissions": [
    "https://members.easynews.com/*"
  ],
  "permissions": ["storage"]
}
